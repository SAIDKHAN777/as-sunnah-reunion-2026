    if (content.welcome) {
      setVal('input-welcome-1', content.welcome.line1);
      setVal('input-welcome-2', content.welcome.line2);
      setVal('input-final-number', content.welcome.finalNumber);
      setVal('input-poster-url', content.welcome.posterUrl || '/assets/meet-greet-poster.webp');
    }
    if (content.centerDisc) {
      setVal('input-logo-url', content.centerDisc.logoUrl || '/assets/logo-as-sunnah.svg');
      setVal('input-title-reg', content.centerDisc.titleRegular);
      setVal('input-title-ita', content.centerDisc.titleItalic);
      setVal('input-script', content.centerDisc.scriptSubtitle);
      setVal('input-date', content.centerDisc.dateLine);
      setVal('input-sched1', content.centerDisc.scheduleLine1);
      setVal('input-sched2', content.centerDisc.scheduleLine2);
    }
    if (content.wheel) {
      const dur = content.wheel.rotationDurationSec || 45;
      setVal('wheel-speed-input', dur);
      const disp = document.getElementById('speed-display');
      if (disp) disp.textContent = `${dur}s / rev (${Math.round(360 / dur)}°/s)`;
    }
  }

  // Hydrate latest live server content if no unsaved draft pending
  async function hydrateFromServerIfClean() {
    if (hasSavedDirtyDraft) {
      refreshDirtyUI('Restored unsaved edits — click Save Changes to apply');
      return;
    }
    try {
      const res = await fetch(`/api/content?ts=${Date.now()}`, { cache: 'no-store' });
      if (res.ok) {
        const liveData = await res.json();
        if (liveData && liveData.welcome && liveData.centerDisc && liveData.wheel) {
          content = liveData;
          syncInputsFromContent();
          updateCenterDiscPreview();
          renderTiles();
          updateCropPreview(activeTileIndex);
        }
      }
    } catch (e) {}
  }

  // Parse latitude/longitude from Google Maps URLs or raw coordinate strings
  function extractCoordsFromText(text) {
    if (!text || typeof text !== 'string') return null;
    const raw = text.trim();

    // Direct lat,lng string
    const direct = raw.match(/^\s*(-?\d+(?:\.\d+)?)\s*,\s*(-?\d+(?:\.\d+)?)\s*$/);
    if (direct) {
      const lat = parseFloat(direct[1]);
      const lng = parseFloat(direct[2]);
      if (lat >= -90 && lat <= 90 && lng >= -180 && lng <= 180) return { lat, lng };
    }

    // Google Maps !3dLAT!4dLNG exact pin format
    const d3d = raw.match(/!3d(-?\d+\.\d+)!4d(-?\d+\.\d+)/);
    if (d3d) return { lat: parseFloat(d3d[1]), lng: parseFloat(d3d[2]) };

    // Google Maps @LAT,LNG viewport/place format
    const atMatch = raw.match(/@(-?\d+\.\d+),(-?\d+\.\d+)/);
    if (atMatch) return { lat: parseFloat(atMatch[1]), lng: parseFloat(atMatch[2]) };

    // Google Maps ?q=LAT,LNG or ?ll=LAT,LNG or query=LAT,LNG
    const qMatch = raw.match(/[?&](?:q|ll|query|destination)=(-?\d+\.\d+),(-?\d+\.\d+)/);
    if (qMatch) return { lat: parseFloat(qMatch[1]), lng: parseFloat(qMatch[2]) };

    return null;
  }

  // Interactive Drag-and-Drop MapLibre + Google Maps Picker Controller
  let mapPickerTileIdx = null;
  let pickedLat = 23.79015;
  let pickedLng = 90.45985;
  let pickedAddressName = 'Satarkul Campus';
  let reverseGeocodeTimer = null;

  async function ensureMapLibreBridge() {
    if (window.__adminMapLibre) return window.__adminMapLibre;
    const deadline = Date.now() + 5000;
    while (!window.__adminMapLibre && Date.now() < deadline) {
      await new Promise((r) => setTimeout(r, 40));
    }
    return window.__adminMapLibre || null;
  }

  const mapPickerModal = document.getElementById('map-picker-modal');
  const mapPickerTitle = document.getElementById('map-picker-title');
  const mapSearchInput = document.getElementById('map-search-input');
  const mapPickedCoordsEl = document.getElementById('map-picked-coords');
  const mapPickedAddrEl = document.getElementById('map-picked-address');
  const mapExternalGmap = document.getElementById('map-picker-external-gmap');
  const mapSpotChipsEl = document.getElementById('maplibre-spot-chips');

  function renderModalSpotChips(bridge, activeCoords) {
    if (!mapSpotChipsEl || !bridge) return;
    const places = bridge.getCampusPlacesSummary();
    mapSpotChipsEl.innerHTML = [
      '<span class="field-label" style="margin-right: 4px;">Campus Spots:</span>',
      ...places.map((p) => {
        const isMatch =
          activeCoords &&
          typeof p.lat === 'number' &&
          typeof p.lng === 'number' &&
          Math.abs(p.lat - activeCoords.lat) < 0.0002 &&
          Math.abs(p.lng - activeCoords.lng) < 0.0002;
        return `<button type="button" class="maplibre-chip-btn ${isMatch ? 'is-active' : ''}" data-spot-id="${p.id}" data-lat="${p.lat}" data-lng="${p.lng}" data-label="${escapeHtml(p.nameBn)} (${escapeHtml(p.nameEn)})">${escapeHtml(p.nameBn)}</button>`;
      }),
      '<button type="button" class="maplibre-chip-btn" data-reset-campus="1">Campus View</button>',
    ].join('');

    mapSpotChipsEl.querySelectorAll('[data-spot-id]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const lat = parseFloat(btn.dataset.lat);
        const lng = parseFloat(btn.dataset.lng);
        const label = btn.dataset.label || '';
        mapSpotChipsEl.querySelectorAll('.maplibre-chip-btn').forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        moveMapPinTo(lat, lng, 17.8, label);
      });
    });

    mapSpotChipsEl.querySelector('[data-reset-campus="1"]')?.addEventListener('click', () => {
      bridge.flyPickerToCampus();
    });
  }

  function updateExternalGoogleMapLink(lat, lng) {
    if (mapExternalGmap) {
      mapExternalGmap.href = `https://www.google.com/maps/search/?api=1&query=${lat.toFixed(5)},${lng.toFixed(5)}`;
    }
  }

  function updatePickedPin(lat, lng, presetAddress = null) {
    pickedLat = lat;
    pickedLng = lng;
    const coordStr = `${lat.toFixed(5)}, ${lng.toFixed(5)}`;
    if (mapPickedCoordsEl) mapPickedCoordsEl.textContent = coordStr;
    updateExternalGoogleMapLink(lat, lng);

    if (presetAddress) {
      pickedAddressName = presetAddress;
      if (mapPickedAddrEl) mapPickedAddrEl.textContent = presetAddress;
      return;
    }

    if (mapPickedAddrEl) mapPickedAddrEl.textContent = 'Finding place name...';
    clearTimeout(reverseGeocodeTimer);
    reverseGeocodeTimer = setTimeout(async () => {
      try {
        const res = await fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lng}`, {
          headers: { 'Accept-Language': 'en' }
        });
        if (res.ok) {
          const data = await res.json();
          const addr = data.address || {};
          const parts = [
            data.name || addr.suburb || addr.neighbourhood || addr.road,
            addr.city || addr.town || addr.county || addr.state_district
          ].filter(Boolean);
          const cleanName = parts.length > 0 ? [...new Set(parts)].join(', ') : (data.display_name || coordStr);
          pickedAddressName = cleanName.slice(0, 120);
          if (mapPickedAddrEl) mapPickedAddrEl.textContent = pickedAddressName;
          return;
        }
      } catch (e) {}
      pickedAddressName = coordStr;
      if (mapPickedAddrEl) mapPickedAddrEl.textContent = coordStr;
    }, 220);
  }

  function moveMapPinTo(lat, lng, zoom = 17.4, presetAddress = null) {
    updatePickedPin(lat, lng, presetAddress);
    window.__adminMapLibre?.movePickerPin(lat, lng, zoom);
  }

  async function searchPlaceOnMap(rawQuery) {
    const query = (rawQuery || '').trim();
    if (!query) return;

    const coords = extractCoordsFromText(query);
    if (coords) {
      moveMapPinTo(coords.lat, coords.lng, 16);
      showToast('Pin moved to extracted coordinates!', 'success');
      return;
    }

    showToast(`Searching map for "${query}"...`);
    try {
      const res = await fetch(`https://nominatim.openstreetmap.org/search?format=json&limit=1&q=${encodeURIComponent(query)}`, {
        headers: { 'Accept-Language': 'en' }
      });
      if (res.ok) {
        const results = await res.json();
        if (results && results.length > 0) {
          const hit = results[0];
          const lat = parseFloat(hit.lat);
          const lng = parseFloat(hit.lon);
          const shortName = (hit.display_name || query).split(',').slice(0, 3).join(',').trim();
          moveMapPinTo(lat, lng, 15, shortName);
          showToast('Location found! Drag the pin if you want to fine-tune it.', 'success');
          return;
        }
      }
      showToast('Place not found — try a nearby city/area name or click directly on the map.', 'error');
    } catch (err) {
      showToast('Search failed: ' + err.message, 'error');
    }
  }

  async function openAdminMapPicker(tileIdx) {
    mapPickerTileIdx = tileIdx;
    const tile = content.wheel.tiles[tileIdx];
    if (mapPickerTitle) {
      mapPickerTitle.textContent = `Pick Location (MapLibre) — #${tileIdx + 1} ${tile?.label || 'Tile'}`;
    }

    const existing = (tile?.location || '').trim();
    if (mapSearchInput) mapSearchInput.value = tile?.locationName || existing;

    mapPickerModal?.classList.remove('hidden');

    const bridge = await ensureMapLibreBridge();
    if (!bridge) {
      showToast('MapLibre failed to initialize — paste Google Maps URL directly.', 'error');
      return;
    }

    const parsed = extractCoordsFromText(existing);
    await bridge.ensurePickerMap({
      containerId: 'leaflet-map',
      initialLat: parsed ? parsed.lat : pickedLat,
      initialLng: parsed ? parsed.lng : pickedLng,
      onChange: updatePickedPin,
    });

    renderModalSpotChips(bridge, parsed);

    if (parsed) {
      moveMapPinTo(parsed.lat, parsed.lng, 17.5, tile?.locationName || null);
    } else if (existing) {
      await searchPlaceOnMap(existing);
    } else {
      moveMapPinTo(23.79015, 90.45985, 17.2, 'Satarkul Campus (Click spot or drag pin)');
    }
  }

  function closeAdminMapPicker() {
    mapPickerModal?.classList.add('hidden');
    mapPickerTileIdx = null;
  }

  document.getElementById('close-map-picker-btn')?.addEventListener('click', closeAdminMapPicker);
  document.getElementById('btn-cancel-map-picker')?.addEventListener('click', closeAdminMapPicker);

  document.getElementById('btn-map-search')?.addEventListener('click', () => {
    searchPlaceOnMap(mapSearchInput?.value);
  });

  mapSearchInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      searchPlaceOnMap(mapSearchInput.value);
    }
  });

  mapSearchInput?.addEventListener('paste', (e) => {
    setTimeout(() => {
      const coords = extractCoordsFromText(mapSearchInput.value);
      if (coords) moveMapPinTo(coords.lat, coords.lng, 16);
    }, 20);
  });

  document.getElementById('btn-map-my-loc')?.addEventListener('click', () => {
    if (!('geolocation' in navigator)) {
      showToast('Browser geolocation unavailable', 'error');
      return;
    }
    showToast('Detecting your current position...');
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        moveMapPinTo(pos.coords.latitude, pos.coords.longitude, 16);
        showToast('Centered on your location!', 'success');
      },
      () => showToast('Unable to get your location — please allow location permission.', 'error'),
      { enableHighAccuracy: false, timeout: 5000 }
    );
  });

  document.getElementById('btn-confirm-map-location')?.addEventListener('click', () => {
    if (mapPickerTileIdx === null || !content.wheel.tiles[mapPickerTileIdx]) {
      closeAdminMapPicker();
      return;
    }
    const idx = mapPickerTileIdx;
    const coordStr = `${pickedLat.toFixed(5)},${pickedLng.toFixed(5)}`;
    content.wheel.tiles[idx].location = coordStr;
    content.wheel.tiles[idx].locationName = pickedAddressName || coordStr;
    markDirty(`tile-${idx}`, `Location pinned for Tile #${idx + 1} — click Save Photo & Tile!`);
    closeAdminMapPicker();
    renderTiles();
    updateCropPreview(idx);
    showToast(`Pinned location for Tile #${idx + 1}! Click "Save Photo & Tile" to save.`, 'success');
  });

  // Initialize
  syncInputsFromContent();
  updateAuthUI();
  updateCenterDiscPreview();
  renderTiles();
  updateCropPreview(0);
  hydrateFromServerIfClean();

  // Deep-link to tab via query param e.g. ?tab=center or ?tab=intro
  const urlTab = new URLSearchParams(window.location.search).get('tab');
  if (urlTab) {
    document.querySelector(`[data-tab="tab-${urlTab}"]`)?.click();
  }
  if (new URLSearchParams(window.location.search).get('auth') === 'open') {
    authModal?.classList.remove('hidden');
  }
</script>
<script>
  import '../scripts/admin-maplibre';
</script>
