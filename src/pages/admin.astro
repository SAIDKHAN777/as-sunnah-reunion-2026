  // Master Save & Publish Engine (Uploads any pending data:URLs to server + persists /content.json)
  async function saveChangesToServer() {
    if (isSaving) return;
    collectFormData();

    if (!adminSecretKey) {
      pendingSaveAfterUnlock = true;
      showToast('Enter Passkey to save your photo & changes to the server!', 'error');
      authModal?.classList.remove('hidden');
      document.getElementById('admin-passkey-input')?.focus();
      return;
    }

    isSaving = true;
    const saveBtns = Array.from(document.querySelectorAll('.js-save-trigger, #btn-publish'));
    const origLabels = new Map();
    saveBtns.forEach(btn => {
      origLabels.set(btn, btn.textContent);
      btn.disabled = true;
      btn.textContent = 'Saving...';
    });

    showToast('Saving photos and content to server...');

    try {
      // 1. Convert & upload any pending data:image/ URLs (Logo, Poster, or Tiles) cleanly via shared helper
      if (content.centerDisc.logoUrl && content.centerDisc.logoUrl.startsWith('data:image/')) {
        const uploadedLogo = await resolvePendingImageUpload(content.centerDisc.logoUrl);
        content.centerDisc.logoUrl = uploadedLogo;
        const logoInput = document.getElementById('input-logo-url');
        if (logoInput) logoInput.value = uploadedLogo;
        updateCenterDiscPreview();
      }

      if (content.welcome.posterUrl && content.welcome.posterUrl.startsWith('data:image/')) {
        const uploadedUrl = await resolvePendingImageUpload(content.welcome.posterUrl);
        content.welcome.posterUrl = uploadedUrl;
        const posterInput = document.getElementById('input-poster-url');
        const posterThumb = document.getElementById('poster-thumb');
        if (posterInput) posterInput.value = uploadedUrl;
        if (posterThumb) posterThumb.src = uploadedUrl;
      }

      for (let i = 0; i < content.wheel.tiles.length; i++) {
        const t = content.wheel.tiles[i];
        if (t.photoUrl && t.photoUrl.startsWith('data:image/')) {
          t.photoUrl = await resolvePendingImageUpload(t.photoUrl);
        }
      }

      // 2. Persist updated JSON to /api/content
      const res = await fetch('/api/content', {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${adminSecretKey}`,
          'x-admin-key': adminSecretKey
        },
        body: JSON.stringify(content)
      });

      if (res.status === 401) {
        pendingSaveAfterUnlock = true;
        showToast('401 Unauthorized: Incorrect Passkey. Please enter valid Passkey.', 'error');
        authModal?.classList.remove('hidden');
        return;
      }

      if (res.status === 429) {
        showToast('Rate Limited (429): Too many wrong attempts — wait 60s and click Save again.', 'error');
        return;
      }

      if (res.ok) {
        try {
          localStorage.setItem('as_sunnah_admin_content', JSON.stringify(content));
        } catch (e) {}
        markClean();
        renderTiles();
        updateCropPreview(activeTileIndex);
        showToast('✓ Saved permanently! Your new photo and text are now live.', 'success');
      } else {
        const data = await res.json().catch(() => ({}));
        showToast(`Save failed: ${data.error || res.statusText}`, 'error');
      }
    } catch (err) {
      if (err.status === 401) {
        pendingSaveAfterUnlock = true;
        showToast('401 Unauthorized: Incorrect Passkey. Enter valid Passkey to save.', 'error');
        authModal?.classList.remove('hidden');
      } else {
        showToast(`Save error: ${err.message}`, 'error');
      }
    } finally {
      isSaving = false;
      saveBtns.forEach(btn => {
        btn.disabled = false;
        if (origLabels.has(btn)) btn.textContent = origLabels.get(btn);
      });
    }
  }

