---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = "As-Sunnah Reunion 2026", description = "Official As-Sunnah Reunion 2026 Interactive Website" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <!-- Prevent flash of unstyled content & preload critical assets -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Alex+Brush&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="mobile-frame" id="app-root">
      <slot />
    </div>
  </body>
</html>
