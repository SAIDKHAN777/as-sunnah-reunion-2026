---
<!-- Two Duotone SVG Filters Definition (Section 4) -->
<svg class="sr-only" aria-hidden="true" width="0" height="0">
  <defs>
    <!-- Filter 1: Ring Photo Purple Monochrome Filter (Main Page S5) -->
    <!-- 0 -> #2B1059, 0.5 -> #6B3AA8, 1 -> #E2D6F5 -->
    <filter id="purple-monochrome-duotone" color-interpolation-filters="sRGB">
      <feColorMatrix
        type="matrix"
        values="0.299 0.587 0.114 0 0
                0.299 0.587 0.114 0 0
                0.299 0.587 0.114 0 0
                0     0     0     1 0"
      />
      <feComponentTransfer>
        <feFuncR type="table" tableValues="0.1686 0.4196 0.8863" />
        <feFuncG type="table" tableValues="0.0627 0.2275 0.8392" />
        <feFuncB type="table" tableValues="0.3490 0.6588 0.9608" />
      </feComponentTransfer>
    </filter>

    <!-- Filter 2: Counter Duotone Filter (Luminance L' + Multiplier) -->
    <!-- L = 0.299R + 0.587G + 0.114B; L' = clamp((L-0.12)*1.3, 0, 1) -->
    <!-- Linear stops: L'=0 -> (.26,.07,.48), 0.45 -> (.93,.52,.14), 0.8 -> (1,.93,.70), 1 -> (1,1,1) -->
    <!-- Multiply by (0.95, 0.64, 0.40) while inside digits -->
    <filter id="counter-duotone-filter" color-interpolation-filters="sRGB">
      <feColorMatrix
        type="matrix"
        values="0.3887 0.7631 0.1482 0 -0.156
                0.3887 0.7631 0.1482 0 -0.156
                0.3887 0.7631 0.1482 0 -0.156
                0      0      0      1 0"
      />
      <feComponentTransfer>
        <feFuncR type="table" tableValues="0.247 0.595 0.950 0.950" />
        <feFuncG type="table" tableValues="0.045 0.333 0.595 0.640" />
        <feFuncB type="table" tableValues="0.192 0.056 0.280 0.400" />
      </feComponentTransfer>
    </filter>
  </defs>
</svg>
