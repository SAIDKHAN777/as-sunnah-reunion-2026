      }
    }
    const localDataUrl = await blobToDataURL(blob);
    return { url: localDataUrl, serverUploaded: false };
  }

  // Update Mini Center Disc Preview
  function updateCenterDiscPreview() {
    const logoUrl = document.getElementById('input-logo-url')?.value.trim() || '/assets/logo-as-sunnah.svg';
    const titleReg = document.getElementById('input-title-reg')?.value || '';
    const titleIta = document.getElementById('input-title-ita')?.value || '';
    const script = document.getElementById('input-script')?.value || '';
    const date = document.getElementById('input-date')?.value || '';
    const sched1 = document.getElementById('input-sched1')?.value || '';
    const sched2 = document.getElementById('input-sched2')?.value || '';

    const pLogo = document.getElementById('preview-logo');
    const thumbLogo = document.getElementById('logo-thumb-preview');
    const pTitleReg = document.getElementById('preview-title-reg');
    const pTitleIta = document.getElementById('preview-title-ita');
    const pScript = document.getElementById('preview-script');
    const pDate = document.getElementById('preview-date');
    const pSched1 = document.getElementById('preview-sched1');
    const pSched2 = document.getElementById('preview-sched2');

    if (pLogo && pLogo.getAttribute('src') !== logoUrl) pLogo.src = logoUrl;
    if (thumbLogo && thumbLogo.getAttribute('src') !== logoUrl) thumbLogo.src = logoUrl;
    if (pTitleReg) pTitleReg.textContent = titleReg + ' ';
    if (pTitleIta) pTitleIta.textContent = titleIta;
    if (pScript) pScript.textContent = script;
    if (pDate) pDate.textContent = date;
    if (pSched1) pSched1.textContent = sched1;
    if (pSched2) pSched2.textContent = sched2;

    // Update Poster Thumb if poster URL changes
    const posterUrl = document.getElementById('input-poster-url')?.value;
    const posterThumb = document.getElementById('poster-thumb');
    if (posterUrl && posterThumb && posterThumb.src !== posterUrl) {
      posterThumb.src = posterUrl;
    }

    // Update Counters
    const updateCount = (inputId, countId, max) => {
      const input = document.getElementById(inputId);
      const countEl = document.getElementById(countId);
      if (input && countEl) {
        const len = input.value.length;
        countEl.textContent = `${len}/${max}`;
        if (len >= max) {
          countEl.classList.add('warning');
        } else {
          countEl.classList.remove('warning');
        }
      }
    };

    updateCount('input-title-reg', 'count-title-reg', 12);
    updateCount('input-title-ita', 'count-title-ita', 12);
    updateCount('input-script', 'count-script', 25);
    updateCount('input-date', 'count-date', 35);
    updateCount('input-sched1', 'count-sched1', 60);
    updateCount('input-sched2', 'count-sched2', 50);
    updateCount('input-welcome-1', 'count-welcome-1', 12);
    updateCount('input-welcome-2', 'count-welcome-2', 12);
  }

  // Update Crop Preview
  function updateCropPreview(index) {
    activeTileIndex = index;
    const tile = content.wheel.tiles[index];
    if (!tile) return;

    const imgEl = document.getElementById('crop-preview-img');
    const chipEl = document.getElementById('crop-preview-chip-text');
    const timeEl = document.getElementById('crop-preview-chip-time');
    const statusEl = document.getElementById('crop-preview-status');

    if (imgEl) imgEl.src = tile.photoUrl;
    if (chipEl) chipEl.textContent = tile.label;
    if (timeEl) {
      const t = (tile.time || '').trim();
      timeEl.textContent = t;
      timeEl.classList.toggle('hidden', !t);
    }
    if (statusEl) statusEl.textContent = `Active: Tile #${index + 1}`;

    document.querySelectorAll('.tile-card').forEach((card, idx) => {
      if (idx === index) {
        card.classList.add('active-tile');
      } else {
        card.classList.remove('active-tile');
      }
    });
  }

  function escapeHtml(str) {
    return String(str || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

