---
interface Props {
  line1?: string;
  line2?: string;
}

const { line1 = "WELCOME", line2 = "HOME" } = Astro.props;
---

<div id="welcome-card" class="welcome-card-container">
  <!-- S1 Clean Floral Plate with Exact Gradients & Floral Lines -->
  <div class="welcome-bg"></div>

  <!-- Central Content Stack -->
  <div class="welcome-content">
    <!-- As-Sunnah Logo -->
    <div class="welcome-logo">
      <img src="/assets/logo-as-sunnah.webp" alt="As-Sunnah Skill Development Institute" width="374" height="256" />
    </div>

    <!-- Typography Stack -->
    <div class="welcome-typography">
      <h1 class="welcome-text-1">{line1}</h1>
      <h2 class="welcome-text-2">{line2}</h2>

      <!-- Divider: 2 lines with center rotated diamond -->
      <div class="welcome-divider">
        <div class="divider-line"></div>
        <div class="divider-diamond"></div>
        <div class="divider-line"></div>
      </div>
    </div>
  </div>

  <!-- Slide-up Bottom Edge FX (Gradient Line + Glow + Shadow) -->
  <div class="bottom-edge-fx"></div>
</div>

<style>
  .welcome-card-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 40;
    overflow: hidden;
    will-change: transform;
    pointer-events: auto;
    background-color: var(--color-card-gradient-top);
  }

  .welcome-bg {
    position: absolute;
    inset: 0;
    background-image: url('/assets/welcome-card-bg.webp');
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    pointer-events: none;
  }

  .welcome-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
  }

  .welcome-logo {
    position: absolute;
    top: 27.5%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 33.3vw;
    max-width: 140px;
  }

  .welcome-logo img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  .welcome-typography {
    position: absolute;
    top: 49.5%;
    left: 50%;
    transform: translate(-50%, -36%);
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .welcome-text-1 {
    margin: 0;
    font-family: 'Playfair Display', 'Bodoni Moda', Georgia, serif;
    font-size: 14vw;
    font-weight: 700;
    color: var(--color-purple-deep);
    letter-spacing: 0.14em;
    text-indent: 0.14em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .welcome-text-2 {
    margin: 0;
    margin-top: 1.5vh;
    font-family: 'Playfair Display', 'Bodoni Moda', Georgia, serif;
    font-size: 14vw;
    font-weight: 700;
    color: var(--color-orange-deep);
    letter-spacing: 0.14em;
    text-indent: 0.14em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .welcome-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2.8vw;
    margin-top: 1.8vh;
  }

  .divider-line {
    width: 13vw;
    max-width: 52px;
    height: 2px;
    background-color: var(--color-orange);
    border-radius: 1px;
  }

  .divider-diamond {
    width: 1.7vw;
    height: 1.7vw;
    min-width: 5px;
    min-height: 5px;
    max-width: 7px;
    max-height: 7px;
    background-color: var(--color-orange);
    transform: rotate(45deg);
  }

  .bottom-edge-fx {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, #6B3AA8 0%, #F28C1E 100%);
    box-shadow: 
      0 -4px 16px rgba(242, 140, 30, 0.55),
      0 35px 70px rgba(0, 0, 0, 0.28);
    pointer-events: none;
  }
</style>