---
import DuotoneFilters from '../components/DuotoneFilters.astro';
import defaultContent from '../../public/content.json';
import '../styles/tokens.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Studio | As-Sunnah Reunion CMS</title>
    <link rel="icon" type="image/svg+xml" href="/assets/logo-as-sunnah.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Alex+Brush&display=swap" rel="stylesheet" />
  </head>
  <body>
    <!-- Include SVG Duotone Filters for Tile Crop Preview -->
    <DuotoneFilters />

    <div class="admin-app" id="admin-root">
      <!-- Top Sticky Navigation & Control Header -->
      <header class="admin-header">
        <div class="header-container">
          <!-- Brand & Subtitle -->
          <div class="brand-group">
            <div class="brand-avatar">AS</div>
            <div>
              <div class="brand-title-row">
                <h1 class="brand-title">As-Sunnah CMS</h1>
                <span class="badge-desktop">PC Studio</span>
              </div>
              <p class="brand-sub">Content Management & Interactive Wheel Studio</p>
            </div>
          </div>

          <!-- Navigation Tabs (PC-Friendly Central Tabs) -->
          <nav class="admin-tabs" role="tablist">
            <button type="button" class="tab-btn active" data-tab="tab-wheel" role="tab" aria-selected="true">
              <span class="tab-icon">🎡</span>
              <span>Wheel & Tiles</span>
            </button>
            <button type="button" class="tab-btn" data-tab="tab-center" role="tab" aria-selected="false">
              <span class="tab-icon">🎯</span>
              <span>Center Disc</span>
            </button>
            <button type="button" class="tab-btn" data-tab="tab-intro" role="tab" aria-selected="false">
              <span class="tab-icon">🎬</span>
              <span>Intro & Cards</span>
            </button>
            <button type="button" class="tab-btn" data-tab="tab-maplibre" role="tab" aria-selected="false">
              <span>MapLibre Map</span>
            </button>
          </nav>

          <!-- Top Actions Toolbar & Auth Status -->
          <div class="header-actions">
            <button type="button" id="auth-status-btn" class="auth-pill locked" title="Click to enter or change Admin Passkey">
              <span class="auth-dot"></span>
              <span id="auth-status-text">Passkey Required</span>
            </button>

            <div class="action-buttons-group">
              <button type="button" id="btn-save-draft" class="btn-action secondary" title="Save changes locally in browser">
                Save Draft
              </button>
              <button type="button" id="btn-preview" class="btn-action accent" title="Open public site with current draft preview">
                Live Preview ↗
              </button>
              <button type="button" id="btn-publish" class="btn-action primary" title="Publish live to /content.json">
                Publish Live
              </button>
            </div>
          </div>
        </div>

        <!-- Sub-bar for Secondary Actions & Breadcrumb -->
        <div class="header-subbar">
          <div class="subbar-container">
            <div class="subbar-left">
              <span class="status-indicator-live">● System Ready</span>
              <span class="subbar-divider">|</span>
              <span class="text-xs text-[#6B3AA8]/70">Target: Public <code>/content.json</code></span>
            </div>
            <div class="subbar-right">
              <button type="button" id="btn-download-json" class="link-subbar">Export JSON</button>
              <span class="subbar-divider">•</span>
              <button type="button" id="btn-revert" class="link-subbar danger">Revert to Defaults</button>
            </div>
          </div>
        </div>
      </header>

      <!-- Passkey Modal -->
      <div id="auth-modal" class="auth-modal hidden">
        <div class="auth-modal-card">
          <div class="modal-header">
            <h3 class="modal-title">Admin Authentication</h3>
            <button type="button" id="close-modal-btn" class="close-btn" aria-label="Close">&times;</button>
          </div>
          <p class="modal-desc">Enter your Admin Passkey to publish live changes to the server.</p>
          <div class="modal-input-group">
            <label for="admin-passkey-input" class="field-label">Admin Secret Key</label>
            <input type="password" id="admin-passkey-input" class="admin-input" placeholder="Enter secret passkey" />
          </div>
          <div class="modal-actions">
            <button type="button" id="save-passkey-btn" class="btn-primary">Unlock Publishing</button>
          </div>
        </div>
      </div>

      <!-- Main Workspace Container -->
      <main class="admin-workspace">
        <!-- Notification Toast -->
        <div id="status-toast" class="status-toast hidden"></div>

        <!-- ========================================================= -->
        <!-- TAB 1: WHEEL & TILES (2-Column Desktop Grid)              -->
        <!-- ========================================================= -->
        <section id="tab-wheel" class="tab-pane active" role="tabpanel">
          <div class="desktop-split-layout">
            <!-- Left Sticky Sidebar: Wheel Settings & Live Annular Crop Preview -->
            <aside class="sidebar-column">
              <!-- Wheel Settings Card -->
              <div class="admin-card">
                <div class="card-header">
                  <div>
                    <h2 class="card-title">Wheel Rotation & Geometry</h2>
                    <p class="card-desc">Master rotation speed for main page</p>
                  </div>
                  <span id="tile-count-badge" class="badge-purple">{defaultContent.wheel.tiles.length} Tiles</span>
                </div>

                <div class="field-group mt-3">
                  <div class="flex-between">
                    <label for="wheel-speed-input" class="field-label">Rotation Duration</label>
                    <span id="speed-display" class="field-hint">45s / rev (8°/s)</span>
                  </div>
                  <input type="range" id="wheel-speed-input" min="15" max="90" step="1" value={defaultContent.wheel.rotationDurationSec} class="admin-range" />
                </div>

                <div id="wheel-save-bar" class="card-save-bar hidden">
                  <span class="unsaved-dot">● Unsaved speed change</span>
                  <button type="button" class="btn-save-now js-save-trigger">💾 Save</button>
                </div>
              </div>

              <!-- Interactive Tile Shape Crop Preview Card (Sticky) -->
              <div class="admin-card sticky-card">
                <div class="card-header">
                  <div>
                    <h2 class="card-title">Tile Crop Preview</h2>
                    <p class="card-desc">Live annular-sector clip-path & duotone</p>
                  </div>
                  <span class="badge-orange">Active Tile</span>
                </div>

                <div class="crop-preview-container">
                  <div class="annular-preview-viewport">
                    <div class="annular-preview-tile" id="crop-preview-tile">
                      <img id="crop-preview-img" src={defaultContent.wheel.tiles[0].photoUrl} alt="Tile preview" class="crop-preview-img" />
                      <div class="crop-preview-chip">
                        <span id="crop-preview-chip-text">{defaultContent.wheel.tiles[0].label}</span>
                        <span id="crop-preview-chip-time" class={`crop-preview-time ${defaultContent.wheel.tiles[0].time ? '' : 'hidden'}`}>{defaultContent.wheel.tiles[0].time || ''}</span>
                      </div>
                    </div>
                  </div>
                  <div class="preview-meta">
                    <span id="crop-preview-status" class="text-xs font-semibold text-[#6B3AA8]">Active: Tile #1</span>
                    <span class="text-xs text-[#E2780C]">Purple Duotone</span>
                  </div>
                </div>
                <p class="text-xs text-[#623096]/70 mt-2">
                  👉 Click any tile on the right to inspect its exact sector crop and label chip position.
                </p>
              </div>
            </aside>

            <!-- Right Column: Tile Grid List -->
            <div class="content-column">
              <div class="admin-card">
                <div class="card-header border-b pb-3 mb-4">
                  <div>
                    <h2 class="card-title text-base">Annular Photo Tiles Collection</h2>
                    <p class="card-desc">Upload photos (auto-resized to WebP &lt; 70KB) and configure uppercase labels</p>
                  </div>
                  <button type="button" id="add-tile-btn" class="btn-primary-small">+ Add New Tile</button>
                </div>

                <!-- Tiles Grid (2-columns on PC) -->
                <div id="tiles-list" class="tiles-grid">
                  <!-- Dynamically populated by JS -->
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- ========================================================= -->
        <!-- TAB 2: CENTER DISC (2-Column Desktop Grid)                -->
        <!-- ========================================================= -->
        <section id="tab-center" class="tab-pane hidden" role="tabpanel">
          <div class="desktop-split-layout">
            <!-- Left Sticky Sidebar: Center Disc Live Preview -->
            <aside class="sidebar-column">
              <div class="admin-card sticky-card">
                <div class="card-header">
                  <div>
                    <h2 class="card-title">Center Disc Live Preview</h2>
                    <p class="card-desc">Real-time circular boundary & typography</p>
                  </div>
                  <span class="badge-purple">Radius 49vw</span>
                </div>

                <div class="disc-preview-container">
                  <div class="mini-center-disc" id="mini-disc-preview">
                    <img id="preview-logo" src={defaultContent.centerDisc.logoUrl} alt="Logo" class="mini-logo" />
                    <div class="mini-title">
                      <span id="preview-title-reg">WELCOME</span>
                      <em id="preview-title-ita">HOME</em>
                    </div>
                    <p class="mini-script" id="preview-script">Reunion 2026</p>
                    <p class="mini-date" id="preview-date">Wednesday, December 16th</p>
                    <div class="mini-sched">
                      <p id="preview-sched1">Network • Diversify • Connect • Expand • Evolve</p>
                      <p id="preview-sched2">As-Sunnah Skill Development Institute</p>
                    </div>
                  </div>
                </div>

                <div class="preview-safety-badge mt-3">
                  <span class="text-xs text-[#16A34A] font-semibold">✓ Circular Bounds Safe</span>
                  <p class="text-xs text-[#623096]/70 mt-1">
                    Text lengths are strictly capped so typography never clips into the rotating wheel tiles.
                  </p>
                </div>
              </div>
            </aside>

            <!-- Right Column: Center Disc Form Fields -->
            <div class="content-column">
              <div class="admin-card">
                <div class="card-header border-b pb-3 mb-4">
                  <div>
                    <h2 class="card-title text-base">Center Disc Logo &amp; Typography</h2>
                    <p class="card-desc">Upload your center logo and edit titles, cursive subtitle, date, and schedule lines</p>
                  </div>
                </div>

                <div class="form-stack">
                  <!-- Center Disc Logo Upload -->
                  <div class="field-group">
                    <div class="flex-between">
                      <label for="input-logo-url" class="field-label">Center Disc Logo (Upload or Path)</label>
                      <button type="button" id="btn-reset-logo" class="btn-reset-inline" title="Restore default As-Sunnah logo">↺ Default Logo</button>
                    </div>
                    <div class="logo-upload-row">
                      <label for="logo-file-input" class="logo-thumb-trigger" title="Click to choose logo from File Manager">
                        <img id="logo-thumb-preview" src={defaultContent.centerDisc.logoUrl} alt="Center Disc Logo Preview" class="logo-thumb-img" />
                      </label>
                      <div class="input-with-upload" style="flex: 1;">
                        <input type="text" id="input-logo-url" class="admin-input" value={defaultContent.centerDisc.logoUrl} placeholder="/assets/logo-as-sunnah.svg" />
                        <label for="logo-file-input" class="btn-upload-inline" title="Open File Manager to upload logo image">
                          📁 Upload Logo
                        </label>
                        <input type="file" id="logo-file-input" accept="image/*" style="display: none;" />
                      </div>
                    </div>
                    <label class="flex items-center gap-2 mt-2 text-xs text-[#3B1A6E] font-medium cursor-pointer select-none">
                      <input type="checkbox" id="opt-logo-remove-bg" checked />
                      <span>Auto-remove white / light gray background &amp; trim border padding</span>
                    </label>
                    <p class="text-xs text-[#623096]/70 mt-1">
                      Transparent PNG, WebP, JPG, or SVG supported — updates the live disc preview immediately.
                    </p>
                  </div>

                  <!-- Title Row (Regular + Italic) -->
                  <div class="grid-2 gap-4">
                    <div class="field-group">
                      <div class="flex-between">
                        <label for="input-title-reg" class="field-label">Title (Regular)</label>
                        <span class="char-counter" id="count-title-reg">7/12</span>
                      </div>
                      <input type="text" id="input-title-reg" class="admin-input uppercase" maxlength="12" value={defaultContent.centerDisc.titleRegular} />
                    </div>
                    <div class="field-group">
                      <div class="flex-between">
                        <label for="input-title-ita" class="field-label">Title (Italic)</label>
                        <span class="char-counter" id="count-title-ita">4/12</span>
                      </div>
                      <input type="text" id="input-title-ita" class="admin-input uppercase" maxlength="12" value={defaultContent.centerDisc.titleItalic} />
                    </div>
                  </div>

                  <!-- Script Subtitle & Date Row -->
                  <div class="grid-2 gap-4">
                    <div class="field-group">
                      <div class="flex-between">
                        <label for="input-script" class="field-label">Cursive Subtitle (Alex Brush)</label>
                        <span class="char-counter" id="count-script">12/25</span>
                      </div>
                      <input type="text" id="input-script" class="admin-input" maxlength="25" value={defaultContent.centerDisc.scriptSubtitle} />
                    </div>
                    <div class="field-group">
                      <div class="flex-between">
                        <label for="input-date" class="field-label">Event Date Line</label>
                        <span class="char-counter" id="count-date">24/35</span>
                      </div>
                      <input type="text" id="input-date" class="admin-input" maxlength="35" value={defaultContent.centerDisc.dateLine} />
                    </div>
                  </div>

                  <!-- Schedule Lines -->
                  <div class="field-group">
                    <div class="flex-between">
                      <label for="input-sched1" class="field-label">Schedule Line 1 (Bullets)</label>
                      <span class="char-counter" id="count-sched1">47/60</span>
                    </div>
                    <input type="text" id="input-sched1" class="admin-input" maxlength="60" value={defaultContent.centerDisc.scheduleLine1} />
                  </div>

                  <div class="field-group">
                    <div class="flex-between">
                      <label for="input-sched2" class="field-label">Schedule Line 2 (Institute Title)</label>
                      <span class="char-counter" id="count-sched2">38/50</span>
                    </div>
                    <input type="text" id="input-sched2" class="admin-input" maxlength="50" value={defaultContent.centerDisc.scheduleLine2} />
                  </div>
                </div>

                <div id="center-save-bar" class="card-save-bar hidden mt-4">
                  <span class="unsaved-dot">● Center Disc has unsaved edits</span>
                  <button type="button" class="btn-save-now js-save-trigger">💾 Save Changes</button>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- ========================================================= -->
        <!-- TAB 3: INTRO & CARDS (2-Column Desktop Grid)              -->
        <!-- ========================================================= -->
        <section id="tab-intro" class="tab-pane hidden" role="tabpanel">
          <div class="desktop-split-layout">
            <!-- Left Card: S1 & S2 Intro -->
            <div class="content-column">
              <div class="admin-card">
                <div class="card-header border-b pb-3 mb-4">
                  <div>
                    <h2 class="card-title text-base">S1 &amp; S2: Welcome Card &amp; Odometer</h2>
                    <p class="card-desc">Opening intro card text and target year counter</p>
                  </div>
                </div>

                <div class="grid-2 gap-4">
                  <div class="field-group">
                    <div class="flex-between">
                      <label for="input-welcome-1" class="field-label">Line 1 (Purple)</label>
                      <span class="char-counter" id="count-welcome-1">7/12</span>
                    </div>
                    <input type="text" id="input-welcome-1" class="admin-input uppercase" maxlength="12" value={defaultContent.welcome.line1} />
                  </div>
                  <div class="field-group">
                    <div class="flex-between">
                      <label for="input-welcome-2" class="field-label">Line 2 (Orange)</label>
                      <span class="char-counter" id="count-welcome-2">4/12</span>
                    </div>
                    <input type="text" id="input-welcome-2" class="admin-input uppercase" maxlength="12" value={defaultContent.welcome.line2} />
                  </div>
                </div>

                <div class="field-group mt-4">
                  <label for="input-final-number" class="field-label">S2 Target Year Number (Odometer Lock)</label>
                  <input type="number" id="input-final-number" class="admin-input" min="1000" max="9999" value={defaultContent.welcome.finalNumber} />
                  <p class="text-xs text-[#623096]/70 mt-1">
                    The odometer reels flip dynamically and land on this number at exactly t = 4.60s.
                  </p>
                </div>

                <div id="intro-save-bar" class="card-save-bar hidden mt-4">
                  <span class="unsaved-dot">● Intro text has unsaved changes</span>
                  <button type="button" class="btn-save-now js-save-trigger">💾 Save Changes</button>
                </div>
              </div>
            </div>

            <!-- Right Card: S3 & S4 Poster -->
            <div class="content-column">
              <div class="admin-card">
                <div class="card-header border-b pb-3 mb-4">
                  <div>
                    <h2 class="card-title text-base">S3 / S4 Meet &amp; Greet Poster</h2>
                    <p class="card-desc">Unveiled at maximum zoom inside digit &quot;6&quot; at t=5.75s, slides left at t=7.00s</p>
                  </div>
                </div>

                <div class="field-group">
                  <label for="input-poster-url" class="field-label">Poster Image Path (Auto-filled on upload)</label>
                  <div class="input-with-upload">
                    <input type="text" id="input-poster-url" class="admin-input" value={defaultContent.welcome.posterUrl || '/assets/meet-greet-poster.webp'} />
                    <label for="poster-file-input" class="btn-upload-inline" title="Open File Manager to upload poster image">
                      📁 Upload Photo
                    </label>
                    <input type="file" id="poster-file-input" accept="image/*" style="display: none;" />
                  </div>
                </div>

                <div class="poster-preview-box mt-4">
                  <label for="poster-file-input" class="poster-thumb-trigger" title="Click to choose poster from File Manager">
                    <img id="poster-thumb" src={defaultContent.welcome.posterUrl || '/assets/meet-greet-poster.webp'} alt="Poster Preview" class="poster-img-preview" />
                    <span class="poster-upload-overlay">📁 Upload Poster</span>
                  </label>
                  <div class="poster-preview-info">
                    <h4 class="font-bold text-sm text-[#3B1A6E]">Poster Resolution Spec</h4>
                    <p class="text-xs text-[#623096]/80 mt-1">Aspect Ratio: <strong>2:3 (e.g. 720×1080 or 1080×1620)</strong></p>
                    <p class="text-xs text-[#623096]/80">Format: WebP or Optimized JPEG</p>
                    <p class="text-xs text-[#E2780C] mt-2 font-semibold">Live Transition: Zooms in digit '6' then slides out left at t=7.00s.</p>
                  </div>
                </div>

                <div id="poster-save-bar" class="card-save-bar hidden mt-4">
                  <span class="unsaved-dot">● New poster selected — click Save to apply</span>
                  <button type="button" id="btn-save-poster" class="btn-save-now js-save-trigger">💾 Save Poster</button>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- ========================================================= -->
        <!-- TAB 4: MAPLIBRE MAP (2-Column Desktop Grid)               -->
        <!-- ========================================================= -->
        <section id="tab-maplibre" class="tab-pane hidden" role="tabpanel">
          <div class="desktop-split-layout">
            <aside class="sidebar-column">
              <div class="admin-card">
                <div class="card-header border-b pb-3 mb-3">
                  <div>
                    <h2 class="card-title text-base">Campus Locations (6)</h2>
                    <p class="card-desc">Select a spot and click on MapLibre to update its pin, or open in Google Maps</p>
                  </div>
                  <button type="button" id="tab-maplibre-download-btn" class="btn-upload-inline small">
                    Download JSON
                  </button>
                </div>
                <div id="tab-maplibre-places-list" class="form-stack"></div>
              </div>
            </aside>

            <div class="content-column">
              <div class="admin-card">
                <div class="card-header border-b pb-3 mb-3">
                  <div>
                    <h2 class="card-title text-base">MapLibre Campus &amp; Park Map</h2>
                    <p class="card-desc">Interactive offline-ready MapLibre terrain with 6 custom venue pins and walking paths</p>
                  </div>
                  <div class="maplibre-tab-toolbar">
                    <button type="button" id="tab-maplibre-campus-btn" class="btn-action secondary">Campus View</button>
                    <button type="button" id="tab-maplibre-3d-btn" class="btn-action secondary" aria-pressed="false">3D</button>
                  </div>
                </div>

                <div class="maplibre-time-strip">
                  <span class="field-label" style="margin: 0;">Preview Clock:</span>
                  <button type="button" class="btn-upload-inline small js-tab-map-time" data-sim-time="07:45">7:45 AM</button>
                  <button type="button" class="btn-upload-inline small js-tab-map-time active" data-sim-time="08:50">8:50 AM</button>
                  <button type="button" class="btn-upload-inline small js-tab-map-time" data-sim-time="13:10">1:10 PM</button>
                  <button type="button" class="btn-upload-inline small js-tab-map-time" data-sim-time="15:15">3:15 PM</button>
                  <button type="button" class="btn-upload-inline small js-tab-map-time" data-sim-time="16:55">4:55 PM</button>
                </div>

                <div id="tab-maplibre-canvas" class="tab-maplibre-canvas"></div>
              </div>
            </div>
          </div>
        </section>
      </main>

      <!-- Interactive Drag-and-Drop MapLibre + Google Maps Picker Modal -->
      <div id="map-picker-modal" class="map-picker-modal hidden" role="dialog" aria-modal="true" aria-labelledby="map-picker-title">
        <div class="map-picker-card">
          <div class="map-picker-header">
            <div>
              <h3 id="map-picker-title" class="modal-title">Pick Location on MapLibre</h3>
              <p class="text-xs text-[#623096]/80">Select a campus spot below, click or drag pin on MapLibre, or open Google Maps</p>
            </div>
            <div class="map-picker-header-right">
              <a id="map-picker-external-gmap" href="https://www.google.com/maps/@23.79015,90.45985,17z" target="_blank" rel="noopener noreferrer" class="btn-upload-inline small" title="Open Google Maps to find/copy coordinates">
                Open Google Maps
              </a>
              <button type="button" id="close-map-picker-btn" class="close-btn" aria-label="Close">&times;</button>
            </div>
          </div>

          <div class="map-search-bar">
            <input type="text" id="map-search-input" class="admin-input" placeholder="Search area or paste Google Maps URL / coordinates..." />
            <button type="button" id="btn-map-search" class="btn-action primary">Find</button>
            <button type="button" id="btn-map-my-loc" class="btn-action secondary" title="Center map on your current location">My Loc</button>
          </div>

          <div id="maplibre-spot-chips" class="maplibre-spot-chips"></div>

          <div id="leaflet-map-container" class="leaflet-map-container">
            <div id="leaflet-map"></div>
          </div>

          <div class="map-picker-footer">
            <div class="map-picked-summary">
              <span class="badge-purple" id="map-picked-coords">23.79015, 90.45985</span>
              <span class="map-picked-address" id="map-picked-address">Satarkul Campus (Click spot or drag pin to adjust)</span>
            </div>
            <div class="map-picker-footer-actions">
              <button type="button" id="btn-cancel-map-picker" class="btn-action secondary">Cancel</button>
              <button type="button" id="btn-confirm-map-location" class="btn-save-now large">Use This Location</button>
            </div>
          </div>
        </div>
      </div>

      <!-- Contextual Floating Save Bar (Appears Automatically on Upload / Edit) -->
      <div id="floating-save-bar" class="floating-save-bar hidden" role="region" aria-label="Save pending changes">
        <div class="floating-save-info">
          <span class="floating-pulse"></span>
          <span id="floating-save-msg">You have unsaved changes — click Save to apply on website</span>
        </div>
