<!-- Standalone Client Script for Admin (0 Bytes leaked to public pages) -->
<script is:inline define:vars={{ defaultContent }}>
  // State management
  let content = JSON.parse(JSON.stringify(defaultContent));
  let activeTileIndex = 0;
  let adminSecretKey = sessionStorage.getItem('as_sunnah_admin_key') || '';
  const dirtySections = new Set();
  let pendingSaveAfterUnlock = false;
  let isSaving = false;

  // Check if there is an unsaved draft in localStorage
  const hasSavedDirtyDraft = localStorage.getItem('as_sunnah_admin_dirty') === '1';
  const savedDraft = localStorage.getItem('as_sunnah_admin_content');
  if (hasSavedDirtyDraft && savedDraft) {
    try {
      content = JSON.parse(savedDraft);
      if (content?.centerDisc?.logoUrl === '/assets/photos/upload_1794301033927.webp') {
        content.centerDisc.logoUrl = '/assets/photos/logo_4th_reunion_transparent_v2.webp';
      }
    } catch (e) {}
  }

  // Toast Helper
  function showToast(message, type = 'normal') {
    const toast = document.getElementById('status-toast');
    if (!toast) return;
    toast.textContent = message;
    toast.className = `status-toast ${type}`;
    toast.classList.remove('hidden');
    clearTimeout(window.__toastTimer);
    window.__toastTimer = setTimeout(() => {
      toast.classList.add('hidden');
    }, 3600);
  }

  // Auth Status Update
  function updateAuthUI() {
    const statusBtn = document.getElementById('auth-status-btn');
    const statusText = document.getElementById('auth-status-text');
    if (!statusBtn || !statusText) return;

    if (adminSecretKey) {
      statusBtn.className = 'auth-pill unlocked';
      statusText.textContent = 'Unlocked';
    } else {
      statusBtn.className = 'auth-pill locked';
      statusText.textContent = 'Passkey Required';
    }
  }

  // Refresh visibility of contextual Save bars & Floating Save banner
  function refreshDirtyUI(customMsg) {
    const mapBar = {
      wheel: 'wheel-save-bar',
      center: 'center-save-bar',
      intro: 'intro-save-bar',
      poster: 'poster-save-bar'
    };

    Object.entries(mapBar).forEach(([key, barId]) => {
      const bar = document.getElementById(barId);
      if (bar) bar.classList.toggle('hidden', !dirtySections.has(key));
    });

    document.querySelectorAll('.tile-card').forEach((card) => {
      const idx = card.dataset.index;
      const row = card.querySelector('.tile-save-row');
      if (row) row.classList.toggle('hidden', !dirtySections.has(`tile-${idx}`));
    });

    const floatingBar = document.getElementById('floating-save-bar');
    const floatingMsg = document.getElementById('floating-save-msg');
    if (floatingBar) {
      const anyDirty = dirtySections.size > 0;
      floatingBar.classList.toggle('hidden', !anyDirty);
      if (anyDirty && customMsg && floatingMsg) {
        floatingMsg.textContent = customMsg;
      }
    }
  }

  function markDirty(sectionKey, customMsg) {
    dirtySections.add(sectionKey);
    collectFormData();
    try {
      localStorage.setItem('as_sunnah_admin_content', JSON.stringify(content));
      localStorage.setItem('as_sunnah_admin_dirty', '1');
    } catch (e) {}
    refreshDirtyUI(customMsg);
  }

  function markClean() {
    dirtySections.clear();
    try {
      localStorage.removeItem('as_sunnah_admin_dirty');
    } catch (e) {}
    refreshDirtyUI();
  }

  // Tab Navigation
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      document.querySelectorAll('.tab-btn').forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      document.querySelectorAll('.tab-pane').forEach(p => p.classList.add('hidden'));

      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');
      const targetId = btn.dataset.tab;
      document.getElementById(targetId)?.classList.remove('hidden');

      if (targetId === 'tab-maplibre') {
        const bridge = await ensureMapLibreBridge();
        if (bridge) await bridge.mountTabMap();
      }
    });
  });

  // Auth Modal Handlers
  const authModal = document.getElementById('auth-modal');
  document.getElementById('auth-status-btn')?.addEventListener('click', () => {
    pendingSaveAfterUnlock = false;
    authModal?.classList.remove('hidden');
    const input = document.getElementById('admin-passkey-input');
    if (input) {
      input.value = adminSecretKey;
      input.focus();
    }
  });

  document.getElementById('close-modal-btn')?.addEventListener('click', () => {
    pendingSaveAfterUnlock = false;
    authModal?.classList.add('hidden');
  });

  document.getElementById('save-passkey-btn')?.addEventListener('click', async () => {
    const input = document.getElementById('admin-passkey-input');
    adminSecretKey = input ? input.value.trim() : '';
    if (adminSecretKey) {
      sessionStorage.setItem('as_sunnah_admin_key', adminSecretKey);
      showToast('Passkey saved! Publishing unlocked.', 'success');
    } else {
      sessionStorage.removeItem('as_sunnah_admin_key');
      showToast('Logged out: Read-only mode.', 'normal');
    }
    updateAuthUI();
    authModal?.classList.add('hidden');

    if (adminSecretKey && pendingSaveAfterUnlock) {
      pendingSaveAfterUnlock = false;
      await saveChangesToServer();
    }
  });

  // Helper: convert data:image/... URL to Blob so deferred uploads save cleanly to server
  function dataURLtoBlob(dataUrl) {
    const parts = dataUrl.split(',');
    const mimeMatch = parts[0].match(/:(.*?);/);
    const mime = mimeMatch ? mimeMatch[1] : 'image/webp';
    const bstr = atob(parts[1]);
    let n = bstr.length;
    const u8arr = new Uint8Array(n);
    while (n--) {
      u8arr[n] = bstr.charCodeAt(n);
    }
    return new Blob([u8arr], { type: mime });
  }

  // Helper: Upload single WebP Blob via POST /api/upload
  async function uploadBlobStrict(blob) {
    const res = await fetch('/api/upload', {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${adminSecretKey}`,
        'x-admin-key': adminSecretKey,
        'Content-Type': blob.type || 'image/webp'
      },
      body: blob
    });
    if (res.status === 401) {
      throw Object.assign(new Error('Invalid admin passkey (401 Unauthorized)'), { status: 401 });
    }
    if (res.status === 429) {
      throw Object.assign(new Error('Too many wrong passkey attempts — wait 60s and retry'), { status: 429 });
    }
    if (!res.ok) {
      const errData = await res.json().catch(() => ({}));
      throw new Error(errData.error || `Upload failed (${res.status})`);
    }
    const data = await res.json();
    return data.url;
  }

  // Helper: Resolve pending data:image/ URL to server-uploaded path on Save
  async function resolvePendingImageUpload(url) {
    if (!url || !url.startsWith('data:image/')) return url;
    const blob = dataURLtoBlob(url);
    return await uploadBlobStrict(blob);
  }

  // Remove uniform light/white box background via edge-decontaminated alpha matting
  function stripLightCanvasBackground(ctx, width, height) {
    const imgData = ctx.getImageData(0, 0, width, height);
    const d = imgData.data;
    const cornerIdx = [
      0,
      (width - 1) * 4,
      (height - 1) * width * 4,
      ((height - 1) * width + width - 1) * 4
    ];

    // Already transparent corners -> keep intact alpha
    if (cornerIdx.every(i => d[i + 3] < 20)) return imgData;

    const avgBg = [0, 1, 2].map(c =>
      Math.round(cornerIdx.reduce((s, i) => s + d[i + c], 0) / cornerIdx.length)
    );
    const bgMin = Math.min(...avgBg);
    const bgSat = Math.max(...avgBg) - bgMin;
    const spread = Math.max(
      ...cornerIdx.map(i => Math.hypot(d[i] - avgBg[0], d[i + 1] - avgBg[1], d[i + 2] - avgBg[2]))
    );
    if (bgMin < 200 || bgSat > 32 || spread > 34) return imgData;

    const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));
    const smoothstep = (e0, e1, x) => {
      const t = clamp((x - e0) / (e1 - e0), 0, 1);
      return t * t * (3 - 2 * t);
    };

    for (let i = 0; i < d.length; i += 4) {
      const r = d[i], g = d[i + 1], b = d[i + 2];
      const origA = d[i + 3] / 255;
      const dist = Math.hypot(r - avgBg[0], g - avgBg[1], b - avgBg[2]);
      const sat = Math.max(r, g, b) - Math.min(r, g, b);

      let alpha = smoothstep(16, 68, dist);
      if (sat >= 28 && dist >= 22) {
        alpha = Math.max(alpha, smoothstep(22, 48, dist + sat * 0.6));
      }

      const finalA = origA * alpha;
      if (finalA <= 0.01) {
        d[i] = d[i + 1] = d[i + 2] = d[i + 3] = 0;
      } else {
        const invA = 1 / Math.max(finalA, 0.08);
        d[i] = Math.round(clamp((r - (1 - finalA) * avgBg[0]) * invA, 0, 255));
        d[i + 1] = Math.round(clamp((g - (1 - finalA) * avgBg[1]) * invA, 0, 255));
        d[i + 2] = Math.round(clamp((b - (1 - finalA) * avgBg[2]) * invA, 0, 255));
        d[i + 3] = Math.round(clamp(finalA * 255, 0, 255));
      }
    }
    ctx.putImageData(imgData, 0, 0);
    return imgData;
  }

  // Crop excess transparent margins cleanly around logo bounds
  function trimCanvasMargins(canvas, ctx, pad = 8) {
    const w = canvas.width, h = canvas.height;
    const d = ctx.getImageData(0, 0, w, h).data;
    let minX = w, minY = h, maxX = -1, maxY = -1;
    for (let y = 0; y < h; y++) {
      for (let x = 0; x < w; x++) {
        if (d[(y * w + x) * 4 + 3] > 8) {
          if (x < minX) minX = x;
          if (x > maxX) maxX = x;
          if (y < minY) minY = y;
          if (y > maxY) maxY = y;
        }
      }
    }
    if (maxX < minX || maxY < minY) return canvas;
    const cropW = maxX - minX + 1;
    const cropH = maxY - minY + 1;
    const out = document.createElement('canvas');
    out.width = cropW + pad * 2;
    out.height = cropH + pad * 2;
    out.getContext('2d')?.drawImage(canvas, minX, minY, cropW, cropH, pad, pad, cropW, cropH);
    return out;
  }

  function applyGrayscaleCanvas(ctx, width, height) {
    const imgData = ctx.getImageData(0, 0, width, height);
    const d = imgData.data;
    for (let i = 0; i < d.length; i += 4) {
      const l = Math.min(255, Math.max(0, Math.round(d[i] * 0.299 + d[i + 1] * 0.587 + d[i + 2] * 0.114)));
      d[i] = l;
      d[i + 1] = l;
      d[i + 2] = l;
    }
    ctx.putImageData(imgData, 0, 0);
  }

  // Client-Side Image Resize & WebP Compression
  async function resizeImageToWebP(file, maxDimension = 800, quality = 0.82, options = {}) {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = (e) => {
        const img = new Image();
        img.onload = () => {
          let width = img.naturalWidth || img.width || 400;
          let height = img.naturalHeight || img.height || 400;

          if (width > maxDimension || height > maxDimension) {
            if (width > height) {
              height = Math.round((height * maxDimension) / width);
              width = maxDimension;
            } else {
              width = Math.round((width * maxDimension) / height);
              height = maxDimension;
            }
          }

          let canvas = document.createElement('canvas');
          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext('2d', { willReadFrequently: Boolean(options.stripLightBackground || options.trimTransparent || options.grayscale) });
          if (!ctx) return reject(new Error('Canvas context unavailable'));
          ctx.drawImage(img, 0, 0, width, height);

          if (options.stripLightBackground) {
            stripLightCanvasBackground(ctx, width, height);
          }
          if (options.trimTransparent) {
            canvas = trimCanvasMargins(canvas, ctx, 8);
          }
          if (options.grayscale) {
            applyGrayscaleCanvas(canvas.getContext('2d'), canvas.width, canvas.height);
          }

          canvas.toBlob((blob) => {
            if (blob) {
              resolve(blob);
            } else {
              reject(new Error('Blob conversion failed'));
            }
          }, 'image/webp', quality);
        };
        img.onerror = reject;
        img.src = e.target.result;
      };
      reader.onerror = reject;
      reader.readAsDataURL(file);
    });
  }

  function blobToDataURL(blob) {
    return new Promise((resolve) => {
      const reader = new FileReader();
      reader.onloadend = () => resolve(reader.result);
      reader.readAsDataURL(blob);
    });
  }

  // Immediate preview upload helper (tries server if unlocked, else previews cleanly until Save clicked)
  async function prepareSelectedImage(blob) {
    if (adminSecretKey) {
      try {
        const serverUrl = await uploadBlobStrict(blob);
        return { url: serverUrl, serverUploaded: true };
      } catch (err) {
        if (err.status === 401) {
          showToast('Passkey invalid! Preview loaded — unlock with valid Passkey when clicking Save.', 'error');
        } else if (err.status === 429) {
