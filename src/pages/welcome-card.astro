---
import WelcomeCard from '../components/WelcomeCard.astro';
import '../styles/tokens.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <title>S1 Welcome Card (Static)</title>
    <link rel="preload" href="/fonts/bodoni-moda-subset.woff2" as="font" type="font/woff2" crossorigin />
    <style>
      html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background-color: var(--color-counter-bg);
      }
      .mobile-viewport {
        position: relative;
        width: 100%;
        height: 100%;
        overflow: hidden;
      }
    </style>
  </head>
  <body>
    <div class="mobile-viewport">
      <WelcomeCard line1="WELCOME" line2="HOME" />
    </div>
  </body>
</html>